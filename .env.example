# Copy to .env (vite dev) and .dev.vars (wrangler dev). Both are gitignored.
OPENAI_API_KEY=
# Optional overrides (defaults shown)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Anonymous daily quota (UTC days)
# ANON_DAILY_LIMIT=5        # per browser
# ANON_IP_DAILY_LIMIT=25    # per IP across browsers (shared networks)
# Signed-in accounts (until credits replace this)
# SIGNED_IN_DAILY_LIMIT=20      # per account
# SIGNED_IN_IP_DAILY_LIMIT=200  # per IP across accounts

# Firebase web config (public identifiers, not secrets). Leave unset to hide sign-in.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_APP_ID=
# Development only: local Firebase Auth emulator (ignored in production builds).
# FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Non-legal rejections are free up to this multiple of the limits above
# QUOTA_REJECTION_MULTIPLIER=3
# Required in production (a long random value mixed into hashed IPs).
# QUOTA_SALT=

# Output token caps per model call
# CLASSIFIER_MAX_TOKENS=8
# ANALYSIS_MAX_TOKENS=2000

# Provider time limits in milliseconds. The classifier fails open on a timeout; an analysis that
# stalls or overruns is refunded and the user sees an error.
# CLASSIFIER_TIMEOUT_MS=8000
# PROVIDER_IDLE_TIMEOUT_MS=20000
# ANALYSIS_TOTAL_TIMEOUT_MS=90000

# Pages a user may attach as background (fetched from Indian Kanoon, India Code and the Supreme
# Court site). Only pages that were really added count.
# URL_FETCH_DAILY_LIMIT=20
# URL_FETCH_IP_DAILY_LIMIT=100

# Verify cited references against real pages with OpenAI's web search, after the answer is shown.
# off (default), signed-in (signed-in users only) or all. Each verification costs about a cent.
# OpenAI only: it uses the Responses API, so it does not work with other OpenAI-compatible providers.
# SOURCE_VERIFICATION=off
# SOURCE_MODEL=            # defaults to OPENAI_MODEL
# SOURCE_TIMEOUT_MS=30000
# SOURCE_MAX_SEARCHES=6

# Compare cases (monthly, UTC; costs about as much as a deep research run). It also uses the
# DEEP_RESEARCH_MODEL / _WRITE_MODEL / _READ_CHARS settings below.
# COMPARE_MONTHLY_LIMIT=1                        # anonymous, per browser
# COMPARE_IP_MONTHLY_LIMIT=5                     # anonymous, per IP
# COMPARE_SIGNED_IN_MONTHLY_LIMIT=3              # per account
# COMPARE_SIGNED_IN_IP_MONTHLY_LIMIT=15          # per IP across accounts
# COMPARE_IDENTIFY_DAILY_LIMIT=10                # finding the two cases, per visitor per day
# COMPARE_IDENTIFY_IP_DAILY_LIMIT=50

# Deep research (monthly, UTC; costs far more than a search)
# DEEP_RESEARCH_MONTHLY_LIMIT=1                  # anonymous, per browser
# DEEP_RESEARCH_IP_MONTHLY_LIMIT=5               # anonymous, per IP
# DEEP_RESEARCH_SIGNED_IN_MONTHLY_LIMIT=3        # per account
# DEEP_RESEARCH_SIGNED_IN_IP_MONTHLY_LIMIT=15    # per IP across accounts
# DEEP_RESEARCH_MODEL=                           # stronger model; defaults to OPENAI_MODEL
# Must be a model whose web_search accepts domain filters: gpt-4.1, gpt-5, gpt-5.1 and gpt-5-mini
# do; gpt-4o-mini and gpt-4.1-mini do not (the request fails with a 400).
# DEEP_RESEARCH_MAX_SEARCHES=12
# DEEP_RESEARCH_READ_SOURCES=4                   # cited pages read to check the brief; 0 turns it off
# DEEP_RESEARCH_READ_CHARS=40000                 # longest part of one page given to the writer
# DEEP_RESEARCH_WRITE_MODEL=                     # writer; any model (it does not search). Default: DEEP_RESEARCH_MODEL
# DEEP_RESEARCH_WRITE_MODEL_INVESTIGATIVE=       # writer for the Investigative tier
# DEEP_RESEARCH_WRITE_MODEL_RESEARCHER=          # writer for the Researcher tier
# DEEP_RESEARCH_REASONING_EFFORT=low             # minimal | low | medium | high, for gpt-5 / o-series writers
# DEEP_RESEARCH_WRITE_MAX_TOKENS=8000            # reasoning tokens included
# DEEP_RESEARCH_PDF_MAX_BYTES=0                  # 0 = PDFs are not read (their quotes cannot be checked)
# DEEP_RESEARCH_TIMEOUT_MS=180000
